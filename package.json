{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @portfolio/api dev",
    "dev:web": "pnpm --filter @portfolio/webs dev",
    "dev": "docker compose up --build",
    "db:migrate": "pnpm --filter @portfolio/api db:migrate",
    "db:seed": "pnpm --filter @portfolio/api db:seed",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @portfolio/api typecheck && pnpm --filter @portfolio/webs typecheck && tsc --noEmit",
    "test": "vitest run tests/unit tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:integration:mysql": "vitest run --config vitest.mysql.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts tests/e2e/auth-real.spec.ts",
    "test:e2e:documents": "playwright test --config playwright.auth.config.ts tests/e2e/documents-real.spec.ts",
    "eval": "vitest run evals/cases",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm eval"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "mysql2": "^3.15.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2"
  }
}
